# OpenAI API ключ
OPENAI_API_KEY=your_openai_api_key_here

# Модели OpenAI для двухфазного анализа
# Быстрая модель по умолчанию (лимит 2.5 млн токенов/день):
OPENAI_MODEL_FAST=gpt-5.4-mini

# Флагманская модель для глубокого риск-аудита:
OPENAI_MODEL_SMART=gpt-5.4-mini

# Демо-режим (True = использование готового эталонного отчета без обращения к API)
MOCK_MODE=False
