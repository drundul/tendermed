# OpenAI API ключ
OPENAI_API_KEY=your_openai_api_key_here

# Модели OpenAI для двухфазного анализа
# Быстрая модель для фильтрации и извлечения таблиц (напр. gpt-4.1-mini, gpt-4o-mini):
OPENAI_MODEL_FAST=gpt-4.1-mini

# Умная модель для глубокого риск-аудита и генерации запросов (напр. gpt-4.1, gpt-4o):
OPENAI_MODEL_SMART=gpt-4.1

# Демо-режим (True = использование готового эталонного отчета без обращения к API)
MOCK_MODE=False
